@model MyFavoritesViewModel
@{
    ViewData["Title"] = "Mis favoritos";
}

<div class="space-y-8">
    <header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Lista de seguimiento</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Propiedades que te interesan.</h1><p class="mt-2 text-sm text-muted">@Model.Favorites.TotalCount @(Model.Favorites.TotalCount == 1 ? "propiedad guardada" : "propiedades guardadas") para comparar con calma.</p></div><a asp-controller="Property" asp-action="Index" class="btn-primary"><i data-lucide="search" class="h-4 w-4"></i>Seguir explorando</a></header>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div>
    }

    @if (Model.Favorites.Items.Count == 0)
    {
        <div class="rounded-3xl border border-dashed border-default bg-[var(--color-bg-elevated)]"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("heart", "Aún no tienes favoritos", "Guarda las propiedades que quieras revisar después y compáralas desde este espacio.", "<a href=\"/Property\" class=\"btn-primary\">Buscar propiedades</a>")' /></div>
    }
    else
    {
        <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3" role="list">
            @foreach (var favorite in Model.Favorites.Items)
            {
                <article class="group overflow-hidden rounded-3xl border border-default bg-[var(--color-bg-elevated)] shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-600/10" role="listitem">
                    <a asp-controller="Property" asp-action="Detail" asp-route-id="@favorite.PropertyId" class="block rounded-3xl" aria-label="Ver detalle de propiedad @favorite.Code"><div class="relative aspect-[16/10] overflow-hidden bg-brand-50 dark:bg-brand-100/20">@if (!string.IsNullOrWhiteSpace(favorite.MainImageUrl)) { <img src="@favorite.MainImageUrl" alt="@favorite.PropertyTypeName, código @favorite.Code" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" loading="lazy" decoding="async" /> } else { <div class="flex h-full items-center justify-center bg-gradient-to-br from-brand-from to-brand-to text-white/55"><i data-lucide="building-2" class="h-14 w-14"></i></div> }<span class="absolute bottom-3 left-3 rounded-xl bg-gray-950/80 px-3 py-1.5 text-sm font-black text-white backdrop-blur">@PriceHelper.FormatCompact(favorite.Price, favorite.Currency)</span></div><div class="p-5"><p class="text-[11px] font-black uppercase tracking-[.14em] text-brand-600">@favorite.SaleTypeName</p><h2 class="mt-1 line-clamp-2 text-base font-extrabold leading-5 text-default group-hover:text-brand-600">@favorite.Description</h2><p class="mt-2 font-mono text-[10px] font-bold text-subtle">REF. @favorite.Code</p><p class="mt-4 text-xs text-muted">Asesor: <span class="font-semibold text-default">@favorite.AgentName</span></p></div></a>
                    <div class="flex items-center justify-between border-t border-default px-5 py-3"><span class="text-xs text-muted">Guardada @favorite.FavoritedAt.ToLocalTime().ToString("dd MMM yyyy")</span><form asp-action="RemoveFavorite" method="post">@Html.AntiForgeryToken()<input type="hidden" name="propertyId" value="@favorite.PropertyId" /><input type="hidden" name="page" value="@Model.Favorites.Page" /><button type="submit" class="inline-flex items-center gap-1.5 text-xs font-bold text-danger-700 transition hover:text-danger-800"><i data-lucide="heart-off" class="h-3.5 w-3.5"></i>Quitar</button></form></div>
                </article>
            }
        </div>
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(ClientController.Favorites), Controller = "Client", CurrentPage = Model.Favorites.Page, TotalPages = Model.Favorites.TotalPages }' />
    }
</div>
