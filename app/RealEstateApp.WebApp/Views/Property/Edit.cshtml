@model EditPropertyViewModel
@{
    ViewData["Title"] = $"Editar {Model.Code}";
    var canSave = Model.PropertyTypes.Count > 0 && Model.SaleTypes.Count > 0 && Model.Improvements.Count > 0;
}

<div class="mx-auto max-w-6xl space-y-7">
    <nav aria-label="Ruta de navegación"><ol class="flex flex-wrap items-center gap-2 text-sm text-muted"><li><a asp-action="MyProperties" class="font-semibold hover:text-brand-600">Mis propiedades</a></li><li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li><li class="font-mono text-xs font-bold text-default" aria-current="page">@Model.Code</li></ol></nav>
    <header class="flex flex-col gap-4 rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between sm:p-8"><div><p class="text-xs font-black uppercase tracking-[.14em] text-brand-600">Edición de inventario</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Refina presentación de propiedad.</h1><p class="mt-2 text-sm text-muted">Código <span class="font-mono font-bold text-default">@Model.Code</span> permanece protegido y no puede modificarse.</p></div><span class="inline-flex self-start items-center gap-2 rounded-full bg-success-50 px-3 py-1.5 text-xs font-black text-success-700"><i data-lucide="circle-check" class="h-4 w-4"></i>Disponible</span></header>
    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div> }

    <form asp-action="Edit" method="post" enctype="multipart/form-data" class="grid items-start gap-7 lg:grid-cols-[minmax(0,1fr)_19rem]" data-property-form novalidate>
        @Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Code" type="hidden" /><input asp-for="Currency" type="hidden" value="DOP" />
        <div class="space-y-6">
            <partial name="_PropertyFormFields" model="Model" />
            <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-5 shadow-sm sm:p-7" aria-labelledby="edit-images-title">
                <div class="mb-5 flex items-start gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500"><i data-lucide="images" class="h-5 w-5"></i></span><div><h2 id="edit-images-title" class="text-lg font-black text-default">Gestionar galería</h2><p class="mt-1 text-sm text-muted">Conserva mínimo una imagen y máximo cuatro en total.</p></div></div>
                <div data-image-uploader data-existing-count="@Model.ExistingImages.Count" data-input-name="newImageFiles">
                    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4" data-existing-images>
                        @foreach (var image in Model.ExistingImages)
                        {
                            <label class="group relative aspect-square cursor-pointer overflow-hidden rounded-2xl border-2 border-transparent bg-[var(--color-bg-muted)] has-[:checked]:border-danger-500" data-existing-image>
                                <img src="@image.Url" alt="Imagen actual de propiedad @Model.Code" class="h-full w-full object-cover transition group-has-[:checked]:opacity-30" />
                                @if (image.IsMain) { <span class="absolute left-2 top-2 rounded-full bg-gray-950/75 px-2 py-1 text-[10px] font-black text-white">Portada</span> }
                                <input type="checkbox" name="ImageIdsToRemove" value="@image.Id" checked="@(Model.ImageIdsToRemove.Contains(image.Id))" class="peer sr-only" data-remove-existing />
                                <span class="absolute inset-x-2 bottom-2 flex items-center justify-center gap-1 rounded-xl bg-white/90 px-2 py-1.5 text-[10px] font-black text-danger-700 shadow-sm dark:bg-gray-900/90"><i data-lucide="trash-2" class="h-3 w-3"></i><span class="peer-checked:hidden">Eliminar</span><span class="hidden peer-checked:inline">Se eliminará</span></span>
                            </label>
                        }
                    </div>
                    <label class="mt-4 flex min-h-32 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-default bg-[var(--color-bg-muted)] px-5 text-center transition hover:border-brand-500" data-drop-zone tabindex="0"><i data-lucide="image-plus" class="h-6 w-6 text-brand-600"></i><span class="mt-2 text-sm font-black text-default">Agregar nuevas imágenes</span><span class="mt-1 text-xs text-muted">JPG, PNG o WebP; máximo 15 MB</span><input type="file" name="newImageFiles" accept="image/jpeg,image/png,image/webp" multiple class="sr-only" data-image-input /></label>
                    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-image-previews aria-live="polite"></div>
                    <div class="mt-3 flex items-center justify-between gap-3"><span class="text-xs font-semibold text-muted" data-image-status></span><span class="text-xs font-semibold text-danger-700" data-image-error role="alert"></span></div>
                    @Html.ValidationMessage("newImageFiles", null, new { @class = "mt-1 block text-xs font-semibold text-danger-700" })
                    <span asp-validation-for="ImageIdsToRemove" class="mt-1 block text-xs font-semibold text-danger-700"></span>
                </div>
            </section>
        </div>
        <aside class="rounded-3xl border border-brand-100 bg-gradient-to-br from-brand-50 to-blue-50 p-5 shadow-sm dark:border-brand-100/20 dark:from-brand-100/15 dark:to-blue-100/10 lg:sticky lg:top-24"><p class="text-xs font-black uppercase tracking-[.14em] text-brand-700 dark:text-brand-500">Valor publicado</p><p class="mt-4 text-2xl font-black text-default" data-price-preview></p><div class="mt-4 rounded-2xl border border-default bg-white/70 p-3 text-xs leading-5 text-muted dark:bg-gray-800/50">Cambios se reflejarán inmediatamente en catálogo público.</div><button type="submit" class="btn-primary mt-6 w-full" disabled="@(!canSave)"><i data-lucide="save" class="h-4 w-4"></i>Guardar propiedad</button><a asp-action="MyProperties" class="btn-secondary mt-3 w-full"><i data-lucide="arrow-left" class="h-4 w-4"></i>Volver atrás</a></aside>
    </form>
</div>

@section Scripts { <script src="~/js/property-form.js" asp-append-version="true"></script> }
