@model PropertyMaintenanceViewModel
@{
    ViewData["Title"] = "Mis propiedades";
}

<div class="space-y-8">
    <header class="relative overflow-hidden rounded-3xl border border-brand-100 bg-gradient-to-br from-slate-950 via-brand-700 to-brand-500 p-6 text-white shadow-xl shadow-brand-600/15 sm:p-9">
        <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-white/10 blur-3xl"></div><div class="relative flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between"><div><p class="text-xs font-black uppercase tracking-[.16em] text-blue-200">Inventario activo</p><h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">Propiedades que representas.</h1><p class="mt-3 max-w-xl text-sm leading-6 text-blue-100">Administra publicaciones disponibles, mantén información vigente y presenta cada inmueble con claridad.</p></div><a asp-action="Create" class="inline-flex min-h-12 shrink-0 items-center justify-center gap-2 rounded-2xl bg-white px-5 text-sm font-black text-brand-700 shadow-lg transition hover:-translate-y-0.5 hover:bg-blue-50"><i data-lucide="plus" class="h-4 w-4"></i>Crear propiedad</a></div>
    </header>

    <section aria-labelledby="inventory-title">
        <div class="mb-5 flex flex-wrap items-end justify-between gap-4"><div><h2 id="inventory-title" class="text-2xl font-black tracking-tight text-default">Disponibles</h2><p class="mt-1 text-sm text-muted">@Model.Properties.TotalCount @(Model.Properties.TotalCount == 1 ? "propiedad activa" : "propiedades activas")</p></div>@if (Model.Properties.TotalPages > 1) { <span class="badge-info">Página @Model.Properties.Page de @Model.Properties.TotalPages</span> }</div>
        @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="mb-5 rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700"></div> }
        @if (Model.Properties.Items.Count == 0)
        {
            <div class="rounded-3xl border border-dashed border-default bg-[var(--color-bg-elevated)]"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("building-2", "Aún no tienes propiedades disponibles", "Publica primer inmueble para comenzar a construir tu inventario inmobiliario.", "<a href=\"/Property/Create\" class=\"btn-primary\">Crear propiedad</a>")' /></div>
        }
        else
        {
            <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-3" role="list">
                @foreach (var property in Model.Properties.Items)
                {
                    <article class="group overflow-hidden rounded-3xl border border-default bg-[var(--color-bg-elevated)] shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-600/10" role="listitem">
                        <div class="relative aspect-[16/10] overflow-hidden bg-brand-50 dark:bg-brand-100/20">@if (!string.IsNullOrWhiteSpace(property.MainImageUrl)) { <img src="@property.MainImageUrl" alt="@property.Title" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" loading="lazy" decoding="async" /> } else { <div class="flex h-full items-center justify-center bg-gradient-to-br from-brand-from to-brand-to text-white/60"><i data-lucide="building-2" class="h-14 w-14"></i></div> }<span class="absolute left-3 top-3 rounded-full bg-success-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wide text-success-700 shadow-sm">Disponible</span><span class="absolute bottom-3 left-3 rounded-xl bg-gray-950/80 px-3 py-1.5 text-sm font-black text-white backdrop-blur">@PriceHelper.FormatCompact(property.Price, property.Currency)</span></div>
                        <div class="p-5"><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="text-[11px] font-black uppercase tracking-[.14em] text-brand-600">@property.SaleTypeName</p><h3 class="mt-1 line-clamp-2 text-base font-extrabold leading-5 text-default">@property.Title</h3></div><span class="shrink-0 font-mono text-[10px] font-bold text-subtle">@property.Code</span></div><dl class="mt-4 grid grid-cols-3 gap-2 border-y border-default py-3 text-xs text-muted"><div class="flex items-center gap-1"><i data-lucide="bed-double" class="h-3.5 w-3.5 text-brand-600"></i><dd>@property.Bedrooms hab.</dd></div><div class="flex items-center gap-1"><i data-lucide="bath" class="h-3.5 w-3.5 text-brand-600"></i><dd>@property.Bathrooms baños</dd></div><div class="flex items-center gap-1"><i data-lucide="ruler" class="h-3.5 w-3.5 text-brand-600"></i><dd>@PriceHelper.FormatArea(property.SizeM2)</dd></div></dl><div class="mt-4 grid grid-cols-3 gap-2"><a asp-controller="Offer" asp-action="PropertyOffers" asp-route-propertyId="@property.Id" class="btn-primary"><i data-lucide="hand-coins" class="h-4 w-4"></i>Ofertas</a><a asp-action="Edit" asp-route-id="@property.Id" class="btn-secondary"><i data-lucide="pencil" class="h-4 w-4"></i>Editar</a><a asp-action="Delete" asp-route-id="@property.Id" class="btn-danger"><i data-lucide="trash-2" class="h-4 w-4"></i>Eliminar</a></div></div>
                    </article>
                }
            </div>
            <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(PropertyController.MyProperties), Controller = "Property", CurrentPage = Model.Properties.Page, TotalPages = Model.Properties.TotalPages }' />
        }
    </section>
</div>
