@model CreateDeveloperViewModel
@{
    ViewData["Title"] = "Nuevo Desarrollador";
}

<div class="mx-auto max-w-2xl space-y-8">
    <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-sm text-muted">
            <li><a asp-action="Developers" class="font-semibold transition-colors hover:text-brand-600">Desarrolladores</a></li>
            <li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li>
            <li class="font-semibold text-default" aria-current="page">Nuevo</li>
        </ol>
    </nav>

    <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:p-9" aria-labelledby="create-title">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/15">
            <i data-lucide="code" class="h-6 w-6"></i>
        </div>
        <p class="mt-6 text-xs font-black uppercase tracking-[.16em] text-brand-600">Gestión</p>
        <h1 id="create-title" class="mt-2 text-3xl font-black tracking-tight text-default">Nuevo Desarrollador</h1>
        <p class="mt-3 max-w-xl text-sm leading-6 text-muted">Crea una cuenta con rol de Desarrollador para acceso a la API de la plataforma.</p>

        <form asp-action="CreateDeveloper" method="post" class="mt-8 space-y-5" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <label asp-for="FirstName" class="label-base flex items-center gap-2">
                      <i data-lucide="user" class="h-4 w-4 text-muted shrink-0"></i>
                      @Html.DisplayNameFor(m => m.FirstName)
                    </label>
                    <input asp-for="FirstName" class="input-base" autocomplete="given-name" autofocus />
                    <span asp-validation-for="FirstName" class="field-validation"></span>
                </div>
                <div class="space-y-1.5">
                    <label asp-for="LastName" class="label-base flex items-center gap-2">
                      <i data-lucide="user" class="h-4 w-4 text-muted shrink-0"></i>
                      @Html.DisplayNameFor(m => m.LastName)
                    </label>
                    <input asp-for="LastName" class="input-base" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-validation"></span>
                </div>
            </div>

            <div class="space-y-1.5">
                <label asp-for="IdentityDocument" class="label-base flex items-center gap-2">
                  <i data-lucide="id-card" class="h-4 w-4 text-muted shrink-0"></i>
                  @Html.DisplayNameFor(m => m.IdentityDocument)
                </label>
                <input asp-for="IdentityDocument" class="input-base" autocomplete="off" />
                <span asp-validation-for="IdentityDocument" class="field-validation"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="Email" class="label-base flex items-center gap-2">
                  <i data-lucide="mail" class="h-4 w-4 text-muted shrink-0"></i>
                  @Html.DisplayNameFor(m => m.Email)
                </label>
                <input asp-for="Email" type="email" class="input-base" autocomplete="email" />
                <span asp-validation-for="Email" class="field-validation"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="UserName" class="label-base flex items-center gap-2">
                  <i data-lucide="at-sign" class="h-4 w-4 text-muted shrink-0"></i>
                  @Html.DisplayNameFor(m => m.UserName)
                </label>
                <input asp-for="UserName" class="input-base" autocomplete="username" />
                <span asp-validation-for="UserName" class="field-validation"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="Password" class="label-base flex items-center gap-2">
                  <i data-lucide="lock" class="h-4 w-4 text-muted shrink-0"></i>
                  @Html.DisplayNameFor(m => m.Password)
                </label>
                <div class="relative">
                    <input asp-for="Password" id="password-input" class="input-base auth-input pr-11" placeholder="Mínimo 8 caracteres" autocomplete="new-password" data-strength-input />
                    <button type="button" data-toggle-password="password-input" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña">
                        <i data-lucide="eye" class="h-4 w-4"></i>
                    </button>
                </div>
                <div id="strength-bar-container" class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
                    <div id="strength-bar" class="h-full w-0 rounded-full transition-all duration-300" role="progressbar" aria-label="Fortaleza de la contraseña"></div>
                </div>
                <p id="strength-text" class="mt-1 text-xs text-muted">Fortaleza: --</p>
                <span asp-validation-for="Password" class="field-validation"></span>
                <span asp-validation-for="Password" class="field-validation"></span>
            </div>

            <div class="space-y-1.5">
                <label asp-for="ConfirmPassword" class="label-base flex items-center gap-2">
                  <i data-lucide="lock" class="h-4 w-4 text-muted shrink-0"></i>
                  @Html.DisplayNameFor(m => m.ConfirmPassword)
                </label>
                <div class="relative">
                    <input asp-for="ConfirmPassword" id="confirm-password-input" class="input-base auth-input pr-11" placeholder="Repite la contraseña" autocomplete="new-password" />
                    <button type="button" data-toggle-password="confirm-password-input" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña">
                        <i data-lucide="eye" class="h-4 w-4"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
            </div>

            <div class="flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-end">
                <a asp-action="Developers" class="btn-secondary">Cancelar</a>
                <button type="submit" class="btn-primary px-6">
                    <i data-lucide="save" class="h-4 w-4"></i>Crear desarrollador
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { RealEstateApp.initPasswordToggles(); RealEstateApp.initPasswordStrength(); });</script>
}
