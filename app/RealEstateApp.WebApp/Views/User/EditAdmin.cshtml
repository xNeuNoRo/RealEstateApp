@model EditAdminViewModel
@{
    ViewData["Title"] = "Editar Administrador";
}

<div class="mx-auto max-w-2xl space-y-8">
    <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-sm text-muted">
            <li><a asp-action="Admins" class="font-semibold transition-colors hover:text-brand-600">Administradores</a></li>
            <li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li>
            <li class="font-semibold text-default" aria-current="page">Editar</li>
        </ol>
    </nav>

    <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:p-9" aria-labelledby="edit-title">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/15">
            <i data-lucide="shield" class="h-6 w-6"></i>
        </div>
        <p class="mt-6 text-xs font-black uppercase tracking-[.16em] text-brand-600">Gestión</p>
        <h1 id="edit-title" class="mt-2 text-3xl font-black tracking-tight text-default">Editar Administrador</h1>
        <p class="mt-3 max-w-xl text-sm leading-6 text-muted">Modifica los datos del administrador <strong class="text-default">@Model.FirstName @Model.LastName</strong>.</p>

        <form asp-action="EditAdmin" method="post" class="mt-8 space-y-6" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700"></div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="mb-2 block text-sm font-black text-default"></label>
                    <input asp-for="FirstName" autocomplete="given-name" autofocus class="form-input min-h-12 text-sm" />
                    <span asp-validation-for="FirstName" class="mt-2 block text-sm font-semibold text-danger-600"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="mb-2 block text-sm font-black text-default"></label>
                    <input asp-for="LastName" autocomplete="family-name" class="form-input min-h-12 text-sm" />
                    <span asp-validation-for="LastName" class="mt-2 block text-sm font-semibold text-danger-600"></span>
                </div>
            </div>

            <div>
                <label asp-for="IdentityDocument" class="mb-2 block text-sm font-black text-default"></label>
                <input asp-for="IdentityDocument" autocomplete="off" class="form-input min-h-12 text-sm" />
                <span asp-validation-for="IdentityDocument" class="mt-2 block text-sm font-semibold text-danger-600"></span>
            </div>

            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-black text-default"></label>
                <input asp-for="Email" type="email" autocomplete="email" class="form-input min-h-12 text-sm" />
                <span asp-validation-for="Email" class="mt-2 block text-sm font-semibold text-danger-600"></span>
            </div>

            <div>
                <label asp-for="UserName" class="mb-2 block text-sm font-black text-default"></label>
                <input asp-for="UserName" autocomplete="username" class="form-input min-h-12 text-sm" />
                <span asp-validation-for="UserName" class="mt-2 block text-sm font-semibold text-danger-600"></span>
            </div>

            <fieldset class="rounded-2xl border border-dashed border-default p-5">
                <legend class="text-sm font-black text-muted px-2">Cambiar contraseña (opcional)</legend>
                <p class="mt-1 text-xs text-muted">Deja los campos vacíos para mantener la contraseña actual.</p>

                <div class="mt-4">
                    <label asp-for="NewPassword" class="mb-2 block text-sm font-black text-default"></label>
                    <div class="relative">
                        <input asp-for="NewPassword" id="new-password-input" autocomplete="new-password" class="form-input min-h-12 pr-10 text-sm" placeholder="Mínimo 8 caracteres" />
                        <button type="button" data-toggle-password="new-password-input" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted hover:text-default" aria-label="Mostrar contraseña">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <div id="strength-bar-container" class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-[var(--color-bg-muted)]">
                        <div id="strength-bar" class="h-full w-0 rounded-full transition-all duration-300" role="progressbar" aria-label="Fortaleza de la contraseña"></div>
                    </div>
                    <p id="strength-text" class="mt-1 text-xs text-muted">Fortaleza: --</p>
                    <span asp-validation-for="NewPassword" class="mt-2 block text-sm font-semibold text-danger-600"></span>
                </div>

                <div class="mt-4">
                    <label asp-for="ConfirmPassword" class="mb-2 block text-sm font-black text-default"></label>
                    <div class="relative">
                        <input asp-for="ConfirmPassword" id="confirm-password-input" autocomplete="new-password" class="form-input min-h-12 pr-10 text-sm" placeholder="Repite la nueva contraseña" />
                        <button type="button" data-toggle-password="confirm-password-input" class="absolute right-3 top-1/2 -translate-y-1/2 p-1 text-muted hover:text-default" aria-label="Mostrar contraseña">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="mt-2 block text-sm font-semibold text-danger-600"></span>
                </div>
            </fieldset>

            <div class="flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-end">
                <a asp-action="Admins" class="btn-secondary min-h-12">Cancelar</a>
                <button type="submit" class="btn-primary min-h-12 px-6">
                    <i data-lucide="save" class="h-4 w-4"></i>Guardar cambios
                </button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <script>document.addEventListener('DOMContentLoaded', () => { RealEstateApp.initPasswordToggles(); RealEstateApp.initPasswordStrength(); });</script>
}
