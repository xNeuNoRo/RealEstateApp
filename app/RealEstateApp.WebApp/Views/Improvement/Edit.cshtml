@model EditImprovementViewModel
@{
    ViewData["Title"] = "Editar Mejora";
}

<div class="mx-auto max-w-2xl space-y-8">
    <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-sm text-muted">
            <li><a asp-action="Index" class="font-semibold transition-colors hover:text-brand-600">Mejoras</a></li>
            <li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li>
            <li class="font-semibold text-default truncate max-w-[12rem]" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:p-9" aria-labelledby="edit-title">
        <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 dark:bg-amber-100/15">
            <i data-lucide="zap" class="h-6 w-6"></i>
        </div>
        <p class="mt-6 text-xs font-black uppercase tracking-[.16em] text-brand-600">Cat&aacute;logo</p>
        <h1 id="edit-title" class="mt-2 text-3xl font-black tracking-tight text-default">Editar @Model.Name</h1>
        <p class="mt-3 max-w-xl text-sm leading-6 text-muted">Modifica el nombre o la descripci&oacute;n de esta mejora.</p>

        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="mt-8 space-y-6" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700"></div>

            <div>
                <label asp-for="Name" class="mb-2 block text-sm font-black text-default"></label>
                <input asp-for="Name" autocomplete="off" class="form-input min-h-12 text-sm" />
                <span asp-validation-for="Name" class="mt-2 block text-sm font-semibold text-danger-600"></span>
            </div>

            <div>
                <label asp-for="Description" class="mb-2 block text-sm font-black text-default"></label>
                <textarea asp-for="Description" rows="3" class="form-input min-h-12 text-sm"></textarea>
                <span asp-validation-for="Description" class="mt-2 block text-sm font-semibold text-danger-600"></span>
            </div>

            <div class="flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-between">
                <a asp-action="Index" class="btn-secondary min-h-12">Cancelar</a>
                <div class="flex flex-col-reverse gap-3 sm:flex-row">
                    <a asp-action="Index" class="btn-ghost min-h-12 text-sm text-muted hidden sm:inline-flex">Descartar cambios</a>
                    <button type="submit" class="btn-primary min-h-12 px-6">
                        <i data-lucide="save" class="h-4 w-4"></i>Guardar cambios
                    </button>
                </div>
            </div>
        </form>
    </section>
</div>
