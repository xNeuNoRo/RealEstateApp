@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAuth";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="auth-card grid w-full max-w-5xl overflow-hidden lg:grid-cols-[1.05fr_.95fr]">
    <section class="auth-showcase hidden min-h-[590px] flex-col justify-between p-10 text-white lg:flex" aria-label="Presentación de RealEstateApp">
        <div>
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-bold backdrop-blur-md">
                <i data-lucide="shield-check" class="h-4 w-4"></i>
                Plataforma inmobiliaria segura
            </span>
            <h2 class="mt-8 max-w-md text-4xl font-black leading-[1.08] tracking-tight">Decisiones inmobiliarias con una experiencia más clara.</h2>
            <p class="mt-4 max-w-md text-sm leading-6 text-blue-100">Descubre propiedades verificadas, conversa con agentes y administra cada paso desde un solo lugar.</p>
        </div>

        <div class="grid grid-cols-3 gap-3" aria-label="Beneficios de la plataforma">
            <div class="auth-metric"><i data-lucide="search" class="h-5 w-5"></i><strong>Explora</strong><span>Filtros precisos</span></div>
            <div class="auth-metric"><i data-lucide="messages-square" class="h-5 w-5"></i><strong>Conecta</strong><span>Agentes reales</span></div>
            <div class="auth-metric"><i data-lucide="heart" class="h-5 w-5"></i><strong>Decide</strong><span>Todo organizado</span></div>
        </div>
    </section>

    <section class="surface-elevated flex min-h-[590px] flex-col justify-center p-6 sm:p-10 lg:p-12">
        <div class="mx-auto w-full max-w-md">
            <div class="mb-8">
                <div class="mb-5 flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500 lg:hidden">
                    <i data-lucide="key-round" class="h-6 w-6"></i>
                </div>
                <p class="mb-2 text-xs font-black uppercase tracking-[0.18em] text-brand-600 dark:text-brand-500">Bienvenido de vuelta</p>
                <h1 class="text-3xl font-black tracking-tight text-default">Inicia sesión</h1>
                <p class="mt-2 text-sm leading-6 text-muted">Accede a tu espacio para continuar donde lo dejaste.</p>
            </div>

            <form asp-action="Login" asp-controller="Auth" method="post" class="space-y-5" data-auth-form>
                @Html.AntiForgeryToken()
                @if (!string.IsNullOrWhiteSpace(returnUrl))
                {
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                }

                <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                <div class="space-y-1.5">
                    <label asp-for="UserNameOrEmail" class="label-base"></label>
                    <div class="relative group">
                        <i data-lucide="user-round" class="auth-input-icon"></i>
                        <input asp-for="UserNameOrEmail" class="input-base auth-input" placeholder="correo@ejemplo.com o usuario" autocomplete="username" autofocus />
                    </div>
                    <span asp-validation-for="UserNameOrEmail" class="field-validation"></span>
                </div>

                <div class="space-y-1.5">
                    <div class="flex items-center justify-between gap-3">
                        <label asp-for="Password" class="label-base mb-0"></label>
                        <a asp-action="ForgotPassword" class="text-xs font-bold text-brand-600 transition-colors hover:text-brand-700 hover:underline dark:text-brand-500">¿Olvidaste tu contraseña?</a>
                    </div>
                    <div class="relative group">
                        <i data-lucide="lock-keyhole" class="auth-input-icon"></i>
                        <input asp-for="Password" id="login-password" class="input-base auth-input pr-11" placeholder="Ingresa tu contraseña" autocomplete="current-password" />
                        <button type="button" data-toggle-password="login-password" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña">
                            <i data-lucide="eye" class="h-4 w-4"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation"></span>
                </div>

                <div class="surface-muted rounded-2xl border border-default p-3.5">
                    @await Html.PartialAsync("~/Views/Shared/Components/_Switch.cshtml", (
                        Name: "RememberMe",
                        Checked: Model.RememberMe,
                        Label: "Mantener sesión iniciada",
                        Description: "Úsalo solo en un dispositivo personal",
                        Icon: "key-round",
                        Color: "blue",
                        Disabled: false,
                        Id: (string?)null
                    ))
                </div>

                <button type="submit" class="auth-submit btn-primary btn-lg w-full" data-submit-label="Iniciar sesión">
                    <span class="auth-submit-content"><i data-lucide="log-in" class="h-4 w-4"></i>Iniciar sesión</span>
                </button>
            </form>

            <div class="mt-7 border-t border-default pt-6 text-center">
                <p class="text-sm text-muted">¿Primera vez en RealEstateApp? <a asp-action="Register" class="font-bold text-brand-600 hover:underline dark:text-brand-500">Crea tu cuenta</a></p>
                <a asp-action="ResendActivation" class="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-subtle transition-colors hover:text-brand-600">
                    <i data-lucide="mail-check" class="h-3.5 w-3.5"></i>
                    Reenviar correo de activación
                </a>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
