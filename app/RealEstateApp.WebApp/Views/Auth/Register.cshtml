@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_LayoutAuth";
    var errorKeys = ViewData.ModelState
        .Where(entry => entry.Value?.Errors.Count > 0)
        .Select(entry => entry.Key)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);
    var initialStep = errorKeys.Overlaps([nameof(Model.FirstName), nameof(Model.LastName), nameof(Model.SelectedRole)])
        ? 1
        : errorKeys.Overlaps([nameof(Model.Phone), nameof(Model.Email)])
            ? 2
            : errorKeys.Count > 0
                ? 3
                : 1;
}

<div class="auth-card w-full max-w-4xl overflow-hidden">
    <div class="grid lg:grid-cols-[280px_1fr]">
        <aside class="auth-showcase relative hidden flex-col justify-between p-8 text-white lg:flex">
            <div>
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/20 bg-white/10 backdrop-blur-md"><i data-lucide="map-pin-house" class="h-5 w-5"></i></span>
                <h2 class="mt-6 text-2xl font-black leading-tight">Empieza tu próxima etapa inmobiliaria.</h2>
                <p class="mt-3 text-sm leading-6 text-blue-100">Un registro guiado, seguro y diseñado para tu objetivo.</p>
            </div>
            <ol class="space-y-5 text-sm" aria-label="Resumen del registro">
                <li class="flex gap-3"><span class="auth-aside-step">1</span><span><strong class="block">Define tu perfil</strong><small class="text-blue-200">Cliente o agente</small></span></li>
                <li class="flex gap-3"><span class="auth-aside-step">2</span><span><strong class="block">Confirma tus datos</strong><small class="text-blue-200">Contacto protegido</small></span></li>
                <li class="flex gap-3"><span class="auth-aside-step">3</span><span><strong class="block">Protege tu cuenta</strong><small class="text-blue-200">Credenciales seguras</small></span></li>
            </ol>
        </aside>

        <section class="surface-elevated p-5 sm:p-8 lg:p-10">
            <div class="mb-7 flex items-start justify-between gap-4">
                <div>
                    <p class="mb-1 text-xs font-black uppercase tracking-[0.18em] text-brand-600 dark:text-brand-500">Únete a la plataforma</p>
                    <h1 class="text-2xl font-black tracking-tight text-default sm:text-3xl">Crea tu cuenta</h1>
                    <p class="mt-1 text-sm text-muted">Solo tomará un par de minutos.</p>
                </div>
                <span id="step-counter" class="rounded-full bg-brand-50 px-3 py-1.5 text-xs font-black text-brand-700 dark:bg-brand-100/20 dark:text-brand-500" aria-live="polite">Paso 1 de 3</span>
            </div>

            <nav class="auth-stepper mb-8" aria-label="Progreso del registro">
                <span class="auth-step is-active" data-step-indicator="1" aria-current="step"><span>1</span><small>Perfil</small></span>
                <div class="auth-step-line" data-step-line="1"></div>
                <span class="auth-step" data-step-indicator="2"><span>2</span><small>Contacto</small></span>
                <div class="auth-step-line" data-step-line="2"></div>
                <span class="auth-step" data-step-indicator="3"><span>3</span><small>Acceso</small></span>
            </nav>

            <form asp-action="Register" asp-controller="Auth" method="post" enctype="multipart/form-data" id="register-form" data-register-stepper data-initial-step="@initialStep" data-auth-form novalidate>
                @Html.AntiForgeryToken()
                <div class="auth-honeypot" aria-hidden="true">
                    <label asp-for="Website">Sitio web</label>
                    <input asp-for="Website" tabindex="-1" autocomplete="off" />
                </div>

                <div asp-validation-summary="All" class="validation-summary mb-5" role="alert"></div>

                <div data-step-panel="1" class="auth-step-panel space-y-6">
                    <div>
                        <h2 class="text-lg font-black text-default">¿Cómo usarás RealEstateApp?</h2>
                        <p class="mt-1 text-sm text-muted">Tu selección personaliza la experiencia inicial.</p>
                    </div>

                    <fieldset>
                        <legend class="sr-only">Tipo de cuenta</legend>
                        <div class="grid gap-3 sm:grid-cols-2">
                            <label class="auth-role-card">
                                <input asp-for="SelectedRole" id="role-client" type="radio" value="Client" class="sr-only" />
                                <span class="auth-role-icon"><i data-lucide="search-check" class="h-5 w-5"></i></span>
                                <span class="min-w-0 flex-1"><strong>Quiero encontrar</strong><small>Explora, guarda y oferta propiedades.</small></span>
                                <span class="auth-role-check"><i data-lucide="check" class="h-3.5 w-3.5"></i></span>
                            </label>
                            <label class="auth-role-card">
                                <input asp-for="SelectedRole" id="role-agent" type="radio" value="Agent" class="sr-only" />
                                <span class="auth-role-icon"><i data-lucide="briefcase-business" class="h-5 w-5"></i></span>
                                <span class="min-w-0 flex-1"><strong>Soy agente</strong><small>Publica y gestiona tus propiedades.</small></span>
                                <span class="auth-role-check"><i data-lucide="check" class="h-3.5 w-3.5"></i></span>
                            </label>
                        </div>
                        <span asp-validation-for="SelectedRole" class="field-validation"></span>
                    </fieldset>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label asp-for="FirstName" class="label-base"></label>
                            <div class="relative"><i data-lucide="user-round" class="auth-input-icon"></i><input asp-for="FirstName" class="input-base auth-input" placeholder="Tu nombre" autocomplete="given-name" required /></div>
                            <span asp-validation-for="FirstName" class="field-validation"></span>
                        </div>
                        <div class="space-y-1.5">
                            <label asp-for="LastName" class="label-base"></label>
                            <div class="relative"><i data-lucide="user-round" class="auth-input-icon"></i><input asp-for="LastName" class="input-base auth-input" placeholder="Tu apellido" autocomplete="family-name" required /></div>
                            <span asp-validation-for="LastName" class="field-validation"></span>
                        </div>
                    </div>
                </div>

                <div data-step-panel="2" class="auth-step-panel hidden space-y-6">
                    <div>
                        <h2 class="text-lg font-black text-default">Mantengámonos en contacto</h2>
                        <p class="mt-1 text-sm text-muted">Usaremos estos datos para tu cuenta y notificaciones importantes.</p>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Phone" class="label-base"></label>
                        <div class="relative"><i data-lucide="phone" class="auth-input-icon"></i><input asp-for="Phone" type="tel" class="input-base auth-input" placeholder="809-555-1234" autocomplete="tel" inputmode="tel" data-phone-mask required /></div>
                        <p class="helper-text">Números 809, 829 o 849 en formato 000-000-0000.</p>
                        <span asp-validation-for="Phone" class="field-validation"></span>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="Email" class="label-base"></label>
                        <div class="relative"><i data-lucide="mail" class="auth-input-icon"></i><input asp-for="Email" class="input-base auth-input" placeholder="tu@correo.com" autocomplete="email" required /></div>
                        <p class="helper-text" data-role-copy="Client">Enviaremos aquí el enlace para activar tu cuenta.</p>
                        <p class="helper-text hidden" data-role-copy="Agent">Te notificaremos cuando un administrador active tu cuenta.</p>
                        <span asp-validation-for="Email" class="field-validation"></span>
                    </div>
                </div>

                <div data-step-panel="3" class="auth-step-panel hidden space-y-5">
                    <div>
                        <h2 class="text-lg font-black text-default">Protege tu acceso</h2>
                        <p class="mt-1 text-sm text-muted">Crea tus credenciales y añade una foto reconocible.</p>
                    </div>

                    <div class="space-y-1.5">
                        <label asp-for="UserName" class="label-base"></label>
                        <div class="relative"><i data-lucide="at-sign" class="auth-input-icon"></i><input asp-for="UserName" class="input-base auth-input" placeholder="usuario123" autocomplete="username" required /></div>
                        <span asp-validation-for="UserName" class="field-validation"></span>
                    </div>

                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="space-y-1.5">
                            <label asp-for="Password" class="label-base"></label>
                            <div class="relative"><i data-lucide="lock-keyhole" class="auth-input-icon"></i><input asp-for="Password" id="register-password" class="input-base auth-input pr-11" placeholder="Mínimo 8 caracteres" autocomplete="new-password" data-strength-input required /><button type="button" data-toggle-password="register-password" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña"><i data-lucide="eye" class="h-4 w-4"></i></button></div>
                            <span asp-validation-for="Password" class="field-validation"></span>
                        </div>
                        <div class="space-y-1.5">
                            <label asp-for="ConfirmPassword" class="label-base"></label>
                            <div class="relative"><i data-lucide="shield-check" class="auth-input-icon"></i><input asp-for="ConfirmPassword" id="register-confirm-password" class="input-base auth-input pr-11" placeholder="Repite la contraseña" autocomplete="new-password" required /><button type="button" data-toggle-password="register-confirm-password" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña"><i data-lucide="eye" class="h-4 w-4"></i></button></div>
                            <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
                        </div>
                    </div>

                    <div class="surface-muted rounded-xl border border-default p-3" data-strength-meter>
                        <div class="flex items-center justify-between text-xs"><span class="font-bold text-default">Seguridad de contraseña</span><span data-strength-label class="font-semibold text-muted">Sin evaluar</span></div>
                        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"><div data-strength-bar class="h-full w-0 rounded-full transition-all duration-300"></div></div>
                        <div class="mt-2 grid grid-cols-2 gap-x-3 gap-y-1 text-[11px] text-muted sm:grid-cols-4">
                            <span data-password-rule="length">8+ caracteres</span><span data-password-rule="case">Mayús. y minús.</span><span data-password-rule="number">Un número</span><span data-password-rule="symbol">Un símbolo</span>
                        </div>
                    </div>

                    <div>
                        <label class="label-base" for="photoFile">Foto de perfil</label>
                        <div id="photo-drop-zone" class="auth-drop-zone" data-drop-zone>
                            <input id="photoFile" name="PhotoFile" type="file" class="sr-only" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" data-photo-input data-val="true" data-val-required="La foto de usuario es requerida." required />
                            <label for="photoFile" class="block cursor-pointer">
                                <span data-photo-placeholder class="flex flex-col items-center">
                                    <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500"><i data-lucide="image-up" class="h-5 w-5"></i></span>
                                    <strong class="text-sm text-default">Arrastra tu foto o haz clic para buscar</strong>
                                    <small class="mt-1 text-xs text-muted">JPG, PNG o WebP · Máximo 15 MB</small>
                                </span>
                                <span data-photo-preview class="hidden items-center gap-4 pr-11 text-left">
                                    <img alt="Vista previa de foto de perfil" class="h-16 w-16 rounded-2xl object-cover ring-4 ring-brand-50 dark:ring-brand-100/20" />
                                    <span class="min-w-0 flex-1"><strong data-photo-name class="block truncate text-sm text-default"></strong><small class="text-xs text-muted">Imagen lista para subir</small></span>
                                </span>
                            </label>
                            <button type="button" data-photo-remove class="absolute right-3 top-1/2 hidden h-9 w-9 -translate-y-1/2 items-center justify-center rounded-xl text-muted hover:bg-danger-50 hover:text-danger-700" aria-label="Quitar foto"><i data-lucide="trash-2" class="h-4 w-4"></i></button>
                        </div>
                        @Html.ValidationMessage("PhotoFile", null, new { @class = "field-validation" })
                    </div>
                </div>

                <div class="mt-8 flex flex-col-reverse items-stretch justify-between gap-3 border-t border-default pt-5 sm:flex-row sm:items-center">
                    <button type="button" class="btn-ghost hidden" data-step-previous><i data-lucide="arrow-left" class="h-4 w-4"></i>Anterior</button>
                    <a asp-action="Login" class="py-2 text-center text-xs font-semibold text-muted hover:text-brand-600 sm:mr-auto">Ya tengo una cuenta</a>
                    <button type="button" class="btn-primary" data-step-next>Siguiente<i data-lucide="arrow-right" class="h-4 w-4"></i></button>
                    <button type="submit" class="auth-submit btn-primary hidden" data-step-submit data-submit-label="Crear mi cuenta"><span class="auth-submit-content"><i data-lucide="user-plus" class="h-4 w-4"></i>Crear mi cuenta</span></button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
