@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nueva contraseña";
    Layout = "_LayoutAuth";
}

<div class="auth-card w-full max-w-lg p-6 sm:p-8">
    <div class="auth-status-icon bg-success-50 text-success-700 dark:text-success-500"><i data-lucide="shield-check" class="h-7 w-7"></i></div>
    <div class="mt-6 text-center">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-600 dark:text-brand-500">Último paso</p>
        <h1 class="mt-2 text-2xl font-black tracking-tight text-default">Crea una nueva contraseña</h1>
        <p class="mt-2 text-sm leading-6 text-muted">Usa una combinación única que no hayas utilizado en otros servicios.</p>
    </div>

    <form asp-action="ResetPassword" method="post" class="mt-7 space-y-5" data-auth-form>
        @Html.AntiForgeryToken()
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

        <div class="space-y-1.5">
            <label asp-for="NewPassword" class="label-base"></label>
            <div class="relative"><i data-lucide="lock-keyhole" class="auth-input-icon"></i><input asp-for="NewPassword" id="reset-password" class="input-base auth-input pr-11" placeholder="Mínimo 8 caracteres" autocomplete="new-password" data-strength-input autofocus /><button type="button" data-toggle-password="reset-password" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña"><i data-lucide="eye" class="h-4 w-4"></i></button></div>
            <span asp-validation-for="NewPassword" class="field-validation"></span>
        </div>

        <div class="surface-muted rounded-xl border border-default p-3" data-strength-meter>
            <div class="flex items-center justify-between text-xs"><span class="font-bold text-default">Seguridad</span><span data-strength-label class="font-semibold text-muted">Sin evaluar</span></div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"><div data-strength-bar class="h-full w-0 rounded-full transition-all duration-300"></div></div>
            <div class="mt-2 grid grid-cols-2 gap-1 text-[11px] text-muted"><span data-password-rule="length">8+ caracteres</span><span data-password-rule="case">Mayús. y minús.</span><span data-password-rule="number">Un número</span><span data-password-rule="symbol">Un símbolo</span></div>
        </div>

        <div class="space-y-1.5">
            <label asp-for="ConfirmPassword" class="label-base"></label>
            <div class="relative"><i data-lucide="shield-check" class="auth-input-icon"></i><input asp-for="ConfirmPassword" id="reset-confirm-password" class="input-base auth-input pr-11" placeholder="Repite la contraseña" autocomplete="new-password" /><button type="button" data-toggle-password="reset-confirm-password" class="auth-password-toggle" aria-label="Mostrar u ocultar contraseña"><i data-lucide="eye" class="h-4 w-4"></i></button></div>
            <span asp-validation-for="ConfirmPassword" class="field-validation"></span>
        </div>

        <button type="submit" class="auth-submit btn-primary btn-lg w-full" data-submit-label="Guardar nueva contraseña"><span class="auth-submit-content"><i data-lucide="check" class="h-4 w-4"></i>Guardar nueva contraseña</span></button>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
