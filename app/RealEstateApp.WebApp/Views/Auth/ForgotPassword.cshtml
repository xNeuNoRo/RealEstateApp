@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar contraseña";
    Layout = "_LayoutAuth";
}

<div class="auth-card w-full max-w-md p-6 sm:p-8">
    <div class="auth-status-icon bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500"><i data-lucide="key-round" class="h-7 w-7"></i></div>
    <div class="mt-6 text-center">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-brand-600 dark:text-brand-500">Recuperación segura</p>
        <h1 class="mt-2 text-2xl font-black tracking-tight text-default">¿Olvidaste tu contraseña?</h1>
        <p class="mt-2 text-sm leading-6 text-muted">Ingresa el correo asociado a tu cuenta. Te enviaremos un enlace para crear una nueva contraseña.</p>
    </div>

    <form asp-action="ForgotPassword" method="post" class="mt-7 space-y-5" data-auth-form>
        @Html.AntiForgeryToken()
        <div class="auth-honeypot" aria-hidden="true"><label asp-for="Website">Sitio web</label><input asp-for="Website" tabindex="-1" autocomplete="off" /></div>
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="space-y-1.5">
            <label asp-for="Email" class="label-base"></label>
            <div class="relative"><i data-lucide="mail" class="auth-input-icon"></i><input asp-for="Email" class="input-base auth-input" placeholder="tu@correo.com" autocomplete="email" autofocus /></div>
            <span asp-validation-for="Email" class="field-validation"></span>
        </div>
        <button type="submit" class="auth-submit btn-primary btn-lg w-full" data-submit-label="Enviar instrucciones"><span class="auth-submit-content"><i data-lucide="send" class="h-4 w-4"></i>Enviar instrucciones</span></button>
    </form>

    <div class="mt-6 border-t border-default pt-5 text-center">
        <a asp-action="Login" class="inline-flex items-center gap-2 text-sm font-bold text-brand-600 hover:underline dark:text-brand-500"><i data-lucide="arrow-left" class="h-4 w-4"></i>Volver a iniciar sesión</a>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
