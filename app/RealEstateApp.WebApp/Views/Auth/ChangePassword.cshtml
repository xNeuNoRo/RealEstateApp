@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="mx-auto max-w-xl space-y-7"><header><p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">Seguridad de cuenta</p><h1 class="mt-2 text-3xl font-black tracking-tight text-default">Actualiza tu contraseña.</h1><p class="mt-2 text-sm leading-6 text-muted">Usa una contraseña única con al menos ocho caracteres.</p></header><form asp-action="ChangePassword" method="post" class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:p-8" data-auth-form>@Html.AntiForgeryToken()<div asp-validation-summary="All" class="mb-5 validation-summary" role="alert"></div><div class="space-y-5"><div class="space-y-1.5"><label asp-for="CurrentPassword" class="label-base"></label><input asp-for="CurrentPassword" class="input-base" autocomplete="current-password" autofocus /><span asp-validation-for="CurrentPassword" class="field-validation"></span></div><div class="space-y-1.5"><label asp-for="NewPassword" class="label-base"></label><input asp-for="NewPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="field-validation"></span></div><div class="space-y-1.5"><label asp-for="ConfirmPassword" class="label-base"></label><input asp-for="ConfirmPassword" class="input-base" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-validation"></span></div></div><div class="mt-8 flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-end"><a asp-controller="Home" asp-action="Index" class="btn-secondary">Cancelar</a><button type="submit" class="btn-primary"><i data-lucide="key-round" class="h-4 w-4"></i>Guardar contraseña</button></div></form></div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
