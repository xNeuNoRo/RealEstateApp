@model PropertyOffersViewModel
@{
    ViewData["Title"] = Model.PageTitle;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string StatusClass(OfferListItemViewModel offer) => offer.Status switch
    {
        "Accepted" => "border-success-500/25 bg-success-50 text-success-700 dark:bg-success-900/20 dark:text-success-500",
        "Rejected" => "border-danger-500/25 bg-danger-50 text-danger-700 dark:bg-danger-900/20 dark:text-danger-500",
        _ => "border-warning-500/25 bg-warning-50 text-warning-700 dark:bg-warning-900/20 dark:text-warning-500",
    };
    string SummaryStatusClass(OfferClientSummaryViewModel client) => client.LastStatus switch
    {
        "Accepted" => "badge-success",
        "Rejected" => "badge-danger",
        _ => "badge-warning",
    };
}

<div class="space-y-8">
    <nav aria-label="Ruta de navegación"><ol class="flex items-center gap-2 text-sm text-muted"><li><a asp-controller="Property" asp-action="MyProperties" class="font-semibold transition-colors hover:text-brand-600">Mis propiedades</a></li><li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li><li class="text-xs text-default" aria-current="page">@Model.PropertyTypeName</li></ol></nav>

    <header class="overflow-hidden rounded-3xl border border-default bg-[var(--color-bg-elevated)] shadow-sm">
        <div class="grid md:grid-cols-[18rem_minmax(0,1fr)]">
            <div class="relative min-h-56 overflow-hidden bg-brand-50 dark:bg-brand-100/20">@if (!string.IsNullOrWhiteSpace(Model.PropertyMainImageUrl)) { <img src="@Model.PropertyMainImageUrl" alt="@Model.PropertyTypeName, código @Model.PropertyCode" class="absolute inset-0 h-full w-full object-cover" /> } else { <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-brand-from to-brand-to text-white/60"><i data-lucide="building-2" class="h-16 w-16"></i></div> }</div>
            <div class="flex flex-col justify-center p-6 sm:p-9"><div class="flex flex-wrap items-center gap-2"><span class="badge-info">@Model.PropertyTypeName</span><span class="@(Model.PropertyStatus == nameof(PropertyStatus.Sold) ? "badge-danger" : "badge-success")">@(Model.PropertyStatus == nameof(PropertyStatus.Sold) ? "Vendida" : "Disponible")</span></div><p class="mt-5 text-xs font-black uppercase tracking-[.16em] text-brand-600">Ofertas recibidas · @Model.PropertyTypeName</p><h1 class="mt-2 line-clamp-2 text-3xl font-black tracking-tight text-default">@Model.PropertyDescription</h1><p class="mt-4 text-2xl font-black text-brand-600">@PriceHelper.Format(Model.PropertyPrice, Model.PropertyCurrency)</p></div>
        </div>
    </header>

    <section aria-labelledby="received-offers-title">
        <div class="mb-5 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between">
            <div><h2 id="received-offers-title" class="text-2xl font-black tracking-tight text-default">@(Model.ClientId is null ? "Clientes interesados" : $"Historial de {Model.ClientName ?? "cliente"}")</h2><p class="mt-1 text-sm text-muted">@(Model.ClientId is null ? $"{Model.Clients.TotalCount} clientes con ofertas" : $"{Model.Offers.TotalCount} propuestas registradas")</p></div>
            @if (Model.ClientId is not null)
            {
                <div class="flex flex-wrap gap-2"><a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" class="btn-secondary min-h-10 px-4 text-xs"><i data-lucide="users" class="h-4 w-4"></i>Todos los clientes</a><a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" asp-route-clientId="@Model.ClientId" class="@(Model.Status is null ? "btn-primary" : "btn-secondary") min-h-10 px-4 text-xs">Todas</a><a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" asp-route-clientId="@Model.ClientId" asp-route-status="@OfferStatus.Pending" class="@(Model.Status == OfferStatus.Pending ? "btn-primary" : "btn-secondary") min-h-10 px-4 text-xs">Pendientes</a><a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" asp-route-clientId="@Model.ClientId" asp-route-status="@OfferStatus.Accepted" class="@(Model.Status == OfferStatus.Accepted ? "btn-primary" : "btn-secondary") min-h-10 px-4 text-xs">Aceptadas</a><a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" asp-route-clientId="@Model.ClientId" asp-route-status="@OfferStatus.Rejected" class="@(Model.Status == OfferStatus.Rejected ? "btn-primary" : "btn-secondary") min-h-10 px-4 text-xs">Rechazadas</a></div>
            }
        </div>

        @if (Model.ClientId is null)
        {
            @if (Model.Clients.Items.Count == 0) { <div class="rounded-3xl border border-dashed border-default bg-[var(--color-bg-elevated)]"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("inbox", "Esta propiedad aún no tiene ofertas", "Cuando un cliente presente una propuesta aparecerá aquí con su actividad más reciente.", "")' /></div> }
            else
            {
                <div class="grid gap-4 md:grid-cols-2" role="list">@foreach (var client in Model.Clients.Items) { <a asp-action="PropertyOffers" asp-route-propertyId="@Model.PropertyId" asp-route-clientId="@client.ClientId" class="group rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-5 shadow-sm transition hover:-translate-y-0.5 hover:border-brand-200 hover:shadow-xl hover:shadow-brand-600/10" role="listitem"><div class="flex items-start justify-between gap-4"><div class="flex min-w-0 items-center gap-3"><div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition group-hover:bg-brand-600 group-hover:text-white dark:bg-brand-100/15 dark:text-brand-500"><i data-lucide="user-round" class="h-6 w-6"></i></div><div class="min-w-0"><h3 class="truncate font-black text-default">@client.ClientName</h3><p class="mt-1 text-xs text-muted">@client.OfferCount @(client.OfferCount == 1 ? "oferta realizada" : "ofertas realizadas")</p></div></div><span class="@SummaryStatusClass(client)">@client.LastStatusLabel</span></div><div class="mt-5 flex items-end justify-between gap-4 border-t border-default pt-4"><div><p class="text-[10px] font-black uppercase tracking-wider text-subtle">Última oferta</p><p class="mt-1 text-xl font-black text-brand-600">@PriceHelper.Format(client.LastAmount, "DOP")</p><p class="mt-1 text-xs text-muted">@client.LastCreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p></div><span class="inline-flex items-center gap-1 text-xs font-black text-brand-600">Ver historial<i data-lucide="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1"></i></span></div></a> }</div>
                <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(OfferController.PropertyOffers), Controller = "Offer", CurrentPage = Model.Clients.Page, TotalPages = Model.Clients.TotalPages, RouteValues = new Dictionary<string, object?> { ["propertyId"] = Model.PropertyId } }' />
            }
        }
        else if (Model.Offers.Items.Count == 0)
        {
            <div class="rounded-3xl border border-dashed border-default bg-[var(--color-bg-elevated)]"><partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='("filter-x", "No hay ofertas con este estado", "Cambia el filtro para consultar el historial completo del cliente.", "")' /></div>
        }
        else
        {
            <div class="space-y-4" role="list">@foreach (var offer in Model.Offers.Items) { <article class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-5 shadow-sm transition hover:shadow-lg sm:p-6" role="listitem"><div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"><div class="flex min-w-0 items-center gap-4"><div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 dark:bg-brand-100/15 dark:text-brand-500"><i data-lucide="receipt-text" class="h-6 w-6"></i></div><div><div class="flex flex-wrap items-center gap-2"><h3 class="font-black text-default">Oferta #@offer.Id</h3><span class="inline-flex items-center rounded-full border px-2.5 py-1 text-[10px] font-black uppercase tracking-wide @StatusClass(offer)">@offer.StatusLabel</span></div><p class="mt-1 inline-flex items-center gap-1.5 text-xs text-muted"><i data-lucide="calendar-clock" class="h-3.5 w-3.5"></i>@offer.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, h:mm tt")</p></div></div><div class="flex flex-col gap-4 sm:flex-row sm:items-center lg:justify-end"><div class="sm:text-right"><p class="text-[10px] font-black uppercase tracking-wider text-subtle">Monto ofertado</p><p class="mt-1 text-2xl font-black text-brand-600">@PriceHelper.Format(offer.Amount, "DOP")</p>@if (offer.RespondedAt.HasValue) { <p class="mt-1 text-xs text-muted">Respondida @offer.RespondedAt.Value.ToLocalTime().ToString("dd MMM yyyy")</p> }</div>@if (offer.IsPending && Model.PropertyStatus == nameof(PropertyStatus.Available)) { <div class="flex gap-2"><form asp-action="Reject" method="post" data-confirm="¿Rechazar esta oferta?" data-confirm-text="La propuesta quedará en el historial como rechazada.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@offer.Id" /><input type="hidden" name="propertyId" value="@Model.PropertyId" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button type="submit" class="btn-danger min-h-10 px-4 text-xs"><i data-lucide="x" class="h-4 w-4"></i>Rechazar</button></form><form asp-action="Accept" method="post" data-confirm="¿Aceptar esta oferta?" data-confirm-text="La propiedad se marcará como vendida y todas las demás ofertas pendientes serán rechazadas.">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@offer.Id" /><input type="hidden" name="propertyId" value="@Model.PropertyId" /><input type="hidden" name="returnUrl" value="@returnUrl" /><button type="submit" class="btn-primary min-h-10 px-4 text-xs"><i data-lucide="check" class="h-4 w-4"></i>Aceptar</button></form></div> }</div></div></article> }</div>
            <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel { Action = nameof(OfferController.PropertyOffers), Controller = "Offer", CurrentPage = Model.Offers.Page, TotalPages = Model.Offers.TotalPages, RouteValues = new Dictionary<string, object?> { ["propertyId"] = Model.PropertyId, ["clientId"] = Model.ClientId, ["status"] = Model.Status } }' />
        }
    </section>
</div>
