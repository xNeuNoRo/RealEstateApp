@model CreateOfferViewModel
@{
    ViewData["Title"] = Model.PageTitle;
}

<div class="mx-auto max-w-6xl space-y-6">
    <nav aria-label="Ruta de navegación"><ol class="flex items-center gap-2 text-sm text-muted"><li><a asp-controller="Property" asp-action="Detail" asp-route-id="@Model.PropertyId" class="font-semibold transition-colors hover:text-brand-600">Propiedad @Model.PropertyCode</a></li><li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li><li class="font-semibold text-default" aria-current="page">Nueva oferta</li></ol></nav>

    <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_24rem]">
        <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm sm:p-9" aria-labelledby="create-offer-title">
            <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/15"><i data-lucide="hand-coins" class="h-6 w-6"></i></div>
            <p class="mt-6 text-xs font-black uppercase tracking-[.16em] text-brand-600">Propuesta económica</p>
            <h1 id="create-offer-title" class="mt-2 text-3xl font-black tracking-tight text-default">Presenta una oferta clara.</h1>
            <p class="mt-3 max-w-xl text-sm leading-6 text-muted">El agente recibirá monto y fecha. Solo puedes mantener una oferta pendiente por propiedad.</p>

            <form asp-action="Create" method="post" class="mt-8 space-y-6" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="PropertyId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700"></div>
                <div>
                    <label asp-for="Amount" class="mb-2 block text-sm font-black text-default"></label>
                    <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-sm font-black text-subtle">RD$</span><input asp-for="Amount" type="number" min="0.01" max="100000000" step="0.01" inputmode="decimal" autocomplete="off" autofocus class="form-input min-h-14 pl-14 text-lg font-black" aria-describedby="amount-help amount-error" /></div>
                    <p id="amount-help" class="mt-2 text-xs leading-5 text-muted">Ingresa un monto mayor que cero y revisa cuidadosamente antes de enviarlo.</p>
                    <span asp-validation-for="Amount" id="amount-error" class="mt-2 block text-sm font-semibold text-danger-600"></span>
                </div>
                <div class="rounded-2xl border border-warning-500/25 bg-warning-50 p-4 text-sm leading-6 text-warning-800 dark:bg-warning-900/15 dark:text-warning-500"><div class="flex gap-3"><i data-lucide="info" class="mt-0.5 h-5 w-5 shrink-0"></i><p>Una oferta aceptada marca la propiedad como vendida. Mientras tu propuesta esté pendiente no podrás enviar otra para este inmueble.</p></div></div>
                <div class="flex flex-col-reverse gap-3 border-t border-default pt-6 sm:flex-row sm:justify-end"><a asp-controller="Property" asp-action="Detail" asp-route-id="@Model.PropertyId" class="btn-secondary min-h-12">Cancelar</a><button type="submit" class="btn-primary min-h-12 px-6"><i data-lucide="send" class="h-4 w-4"></i>Enviar oferta</button></div>
            </form>
        </section>

        <aside class="lg:sticky lg:top-20 lg:self-start" aria-label="Resumen de la propiedad">
            <article class="overflow-hidden rounded-3xl border border-default bg-[var(--color-bg-elevated)] shadow-sm">
                <div class="relative aspect-[16/11] overflow-hidden bg-brand-50 dark:bg-brand-100/20">@if (!string.IsNullOrWhiteSpace(Model.PropertyMainImageUrl)) { <img src="@Model.PropertyMainImageUrl" alt="@Model.PropertyTypeName, código @Model.PropertyCode" class="h-full w-full object-cover" /> } else { <div class="flex h-full items-center justify-center bg-gradient-to-br from-brand-from to-brand-to text-white/60"><i data-lucide="building-2" class="h-14 w-14"></i></div> }<span class="absolute bottom-3 left-3 rounded-xl bg-gray-950/80 px-3 py-1.5 text-sm font-black text-white backdrop-blur">@PriceHelper.Format(Model.PropertyPrice, Model.PropertyCurrency)</span></div>
                <div class="p-5"><p class="text-[11px] font-black uppercase tracking-[.14em] text-brand-600">@Model.SaleTypeName · @Model.PropertyTypeName</p><h2 class="mt-2 line-clamp-3 text-lg font-black text-default">@Model.PropertyDescription</h2><p class="mt-3 font-mono text-xs font-bold text-subtle">REF. @Model.PropertyCode</p></div>
            </article>
        </aside>
    </div>
</div>
