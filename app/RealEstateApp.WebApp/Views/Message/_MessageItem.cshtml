@model MessageViewModel
@inject ICurrentUserService CurrentUser
@{
    var isMine = string.Equals(Model.SenderId, CurrentUser.UserId, StringComparison.Ordinal);
    var alignClass = isMine ? "flex-row-reverse" : "justify-start";
    var bubbleClass = isMine
        ? "bg-brand-600 text-white rounded-2xl rounded-tr-sm"
        : "bg-[var(--color-bg-tertiary)] text-default rounded-2xl rounded-tl-sm";
}

<div class="flex w-full items-start gap-3 @alignClass" role="listitem" aria-label="@(isMine ? "Tu mensaje" : "Mensaje de " + Model.SenderName)">
    @if (!isMine)
    {
        <div class="w-8 h-8 shrink-0 rounded-full bg-brand-100 dark:bg-brand-900/30 flex items-center justify-center">
            <span class="text-[11px] font-black text-brand-700 dark:text-brand-300">
                @(!string.IsNullOrWhiteSpace(Model.SenderName) ? Model.SenderName.Substring(0, 1).ToUpper() : "?")
            </span>
        </div>
    }

    @if (isMine)
    {
        <div class="w-8 h-8 shrink-0 rounded-full bg-brand-600 flex items-center justify-center">
            <i data-lucide="send" class="h-4 w-4 text-white/80" aria-hidden="true"></i>
        </div>
    }

    <div class="max-w-[65%] px-4 py-2.5 shadow-sm @bubbleClass">
        @if (!isMine && !string.IsNullOrWhiteSpace(Model.SenderName))
        {
            <p class="mb-1 text-[10px] font-bold uppercase tracking-wide opacity-70">@Model.SenderName</p>
        }
        <p class="whitespace-pre-wrap break-words text-sm leading-relaxed">@Model.Content</p>
        <time class="mt-1.5 block text-right text-[10px] opacity-60" datetime="@Model.SentAt.ToString("o")">
            @Model.SentAt.ToLocalTime().ToString("HH:mm")
        </time>
    </div>
</div>
