@model ConversationViewModel
@inject ICurrentUserService CurrentUser
@using Microsoft.AspNetCore.Routing
@{
    var isAgent = CurrentUser.IsInRole("Agent");
    ViewData["Title"] = $"Conversación: {Model.PropertyCode}";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var conversationRouteValues = new Dictionary<string, object?>
    {
        ["propertyId"] = Model.PropertyId,
    };
    if (isAgent && !string.IsNullOrWhiteSpace(Model.OtherUserId))
        conversationRouteValues["clientId"] = Model.OtherUserId;
}

<div class="space-y-6">
    <nav aria-label="Ruta de navegación">
        <ol class="flex items-center gap-2 text-sm text-muted">
            <li><a asp-action="Index" class="font-semibold transition-colors hover:text-brand-600">Mensajes</a></li>
            <li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li>
            <li class="font-mono text-xs text-default" aria-current="page">@Model.PropertyCode</li>
        </ol>
    </nav>

    <header class="overflow-hidden rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-6 shadow-sm">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-50 dark:bg-brand-100/20">
                    <i data-lucide="building-2" class="h-7 w-7 text-brand-600"></i>
                </div>
                <div class="min-w-0">
                    <p class="text-xs font-black uppercase tracking-[.16em] text-brand-600">@Model.PropertyCode</p>
                    <h1 class="mt-1 line-clamp-2 text-2xl font-black tracking-tight text-default">@Model.PropertyDescription</h1>
                    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm text-muted">
                        <span class="font-semibold text-default">@Model.OtherUserName</span>
                        <span aria-hidden="true">·</span>
                        <span class="rounded-full px-2 py-0.5 text-[10px] font-bold uppercase @(isAgent ? "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300" : "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300")">
                            @(isAgent ? "Cliente" : "Asesor")
                        </span>
                    </div>
                </div>
            </div>
            @if (!isAgent)
            {
                <a asp-controller="Home" asp-action="Detail" asp-route-id="@Model.PropertyId" class="btn-secondary shrink-0">
                    <i data-lucide="eye" class="h-4 w-4"></i>Ver propiedad
                </a>
            }
        </div>
    </header>

    <section class="overflow-hidden rounded-2xl border border-default bg-[var(--color-bg-elevated)]" aria-label="Historial de mensajes">
        <div class="h-[55vh] min-h-[360px] overflow-y-auto p-5 sm:p-6 custom-scrollbar" role="log" aria-live="polite" aria-label="Mensajes">
            @if (Model.Messages.Items.Count == 0)
            {
                <div class="flex h-full items-center justify-center">
                    <div class="text-center">
                        <i data-lucide="messages-square" class="mx-auto h-10 w-10 text-subtle"></i>
                        <p class="mt-3 text-sm font-bold text-default">
                            @(isAgent ? "No hay mensajes aún." : "Sin mensajes aún.")
                        </p>
                        <p class="mt-1 text-xs text-muted">
                            @(isAgent ? "El cliente aún no ha escrito." : "Envía el primer mensaje para iniciar la conversación.")
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="space-y-4" role="list">
                    @foreach (var message in Model.Messages.Items)
                    {
                        <partial name="_MessageItem" model="message" />
                    }
                </div>
            }
        </div>

        @if (Model.Messages.TotalPages > 1 && Model.Messages.Page > 1)
        {
            <div class="border-t border-default px-4 py-2 text-center">
                <a asp-action="Conversation"
                   asp-route-propertyId="@Model.PropertyId"
                   asp-route-clientId="@(isAgent ? Model.OtherUserId : null)"
                   asp-route-page="@(Model.Messages.Page - 1)"
                   class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 transition hover:text-brand-700">
                    <i data-lucide="chevron-up" class="h-3.5 w-3.5"></i>Ver mensajes anteriores
                </a>
            </div>
        }
    </section>

    @if (Model.Messages.TotalPages > 1)
    {
        <partial name="~/Views/Home/_Pagination.cshtml" model='new PaginationViewModel {
            Action = nameof(MessageController.Conversation),
            Controller = "Message",
            CurrentPage = Model.Messages.Page,
            TotalPages = Model.Messages.TotalPages,
            RouteValues = conversationRouteValues }' />
    }

    <form asp-action="@(isAgent ? "Reply" : "Send")" method="post" class="space-y-3">
        @Html.AntiForgeryToken()
        <input type="hidden" name="propertyId" value="@Model.PropertyId" />
        @if (isAgent)
        {
            <input type="hidden" name="messageId" value="@Model.ReplyToMessageId" />
            <input type="hidden" name="clientId" value="@Model.OtherUserId" />
        }

        <div class="flex gap-3">
            <textarea name="content" rows="2" maxlength="2000" required
                      class="flex-1 resize-none rounded-2xl border border-default bg-[var(--color-bg-tertiary)] px-4 py-3 text-sm text-default placeholder:text-muted transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20"
                      placeholder="@(isAgent ? "Escribe tu respuesta…" : "Escribe tu mensaje…")"
                      aria-label="Escribe tu mensaje" autofocus></textarea>
            <button type="submit" class="btn-primary shrink-0 min-h-[48px] px-5">
                <i data-lucide="send" class="h-4 w-4"></i>
                <span class="hidden sm:inline">@(isAgent ? "Responder" : "Enviar")</span>
            </button>
        </div>
    </form>
</div>
