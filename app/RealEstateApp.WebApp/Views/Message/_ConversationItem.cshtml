@model ConversationSummaryViewModel
@inject ICurrentUserService CurrentUser
@using Microsoft.AspNetCore.Routing
@{
    var isAgent = CurrentUser.IsInRole("Agent");
    var myRole = isAgent ? "Agent" : "Client";
    var isUnread = !string.Equals(Model.LastMessageSenderType, myRole, StringComparison.Ordinal);
    var roleLabel = Model.OtherUserRole == "Agent" ? "Asesor" : "Cliente";
    var roleBadge = Model.OtherUserRole == "Agent"
        ? "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300"
        : "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300";

    var routeValues = isAgent
        ? new RouteValueDictionary { ["propertyId"] = Model.PropertyId, ["clientId"] = Model.OtherUserId }
        : new RouteValueDictionary { ["propertyId"] = Model.PropertyId };
    var href = Url.Action("Conversation", "Message", routeValues);
}

<article class="group overflow-hidden rounded-2xl border border-default bg-[var(--color-bg-elevated)] shadow-sm transition duration-300 hover:border-brand-300 hover:shadow-md @(isUnread ? "ring-1 ring-brand-400/60" : "")" role="listitem">
    <a href="@href" class="flex items-start gap-4 p-4" aria-label="Abrir conversación con @Model.OtherUserName sobre @Model.PropertyDescription">
        <div class="relative w-16 h-16 shrink-0 overflow-hidden rounded-xl bg-brand-50 dark:bg-brand-100/20 flex items-center justify-center">
            <i data-lucide="building-2" class="h-7 w-7 text-brand-400"></i>
            @if (isUnread)
            {
                <span class="absolute right-1.5 top-1.5 h-2.5 w-2.5 rounded-full bg-success-500 ring-2 ring-white dark:ring-gray-900" aria-label="Mensaje sin leer" title="Mensaje sin leer"></span>
            }
        </div>

        <div class="min-w-0 flex-1">
            <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                    <p class="text-[11px] font-black uppercase tracking-[.14em] text-brand-600">@Model.PropertyCode</p>
                    <h3 class="mt-0.5 truncate font-extrabold text-default transition-colors group-hover:text-brand-600">@Model.PropertyDescription</h3>
                </div>
                <time class="shrink-0 whitespace-nowrap text-[10px] text-muted" datetime="@Model.LastMessageAt.ToString("o")">@Model.LastMessageAt.ToLocalTime().ToString("dd MMM HH:mm")</time>
            </div>

            <div class="mt-2 flex items-center gap-2 text-sm text-muted">
                <span class="font-semibold text-default">@Model.OtherUserName</span>
                <span aria-hidden="true">·</span>
                <span class="rounded-full px-1.5 py-0.5 text-[10px] font-bold uppercase @roleBadge">@roleLabel</span>
            </div>

            <p class="mt-1.5 line-clamp-2 text-sm text-muted">@Model.LastMessageContent</p>
        </div>

        <i data-lucide="chevron-right" class="h-5 w-5 shrink-0 self-center text-muted transition-colors group-hover:text-brand-600" aria-hidden="true"></i>
    </a>
</article>
