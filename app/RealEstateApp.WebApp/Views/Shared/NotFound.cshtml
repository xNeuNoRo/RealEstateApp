@{
    ViewData["Title"] = "Página no encontrada";
}
<div class="flex items-center justify-center min-h-[70vh] py-8 page-entry">
    <div class="text-center max-w-md">
        <h1 class="text-9xl font-black text-gray-100 dark:text-gray-800 tracking-tighter mb-4">404</h1>
        <div class="w-20 h-20 surface-muted rounded-full flex items-center justify-center mx-auto mb-6">
            <i data-lucide="file-question" class="w-10 h-10 text-subtle"></i>
        </div>
        <h2 class="text-2xl font-bold text-default mb-2">Página no encontrada</h2>
        <p class="text-muted mb-8">La página que busca no existe o ha sido movida. Verifique la URL e intente nuevamente.</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn-primary px-6 py-3">
                <i data-lucide="home" class="w-4 h-4"></i>
                Volver al Inicio
            </a>
            <button onclick="history.back()" class="btn-secondary px-6 py-3">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                Regresar
            </button>
        </div>
    </div>
</div>
@section Scripts {
    <script>lucide.createIcons();</script>
}
