@model (string Label, string Name, string? Value, string? Type, string? Error, string? Hint, string? Icon, string? Placeholder, string? CssClass)
@{
    var hasError = !string.IsNullOrEmpty(Model.Error);
    var inputId = $"input-{Model.Name}";
}
<div class="space-y-1.5 @Model.CssClass">
    <label for="@inputId" class="label-base">
        @Model.Label
    </label>
    <div class="relative">
        @if (!string.IsNullOrEmpty(Model.Icon))
        {
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                <i data-lucide="@Model.Icon" class="w-4 h-4 text-subtle"></i>
            </div>
        }
        <input id="@inputId"
               name="@Model.Name"
               type="@(Model.Type ?? "text")"
               value="@Model.Value"
               placeholder="@Model.Placeholder"
               class="input-base @(string.IsNullOrEmpty(Model.Icon) ? "" : "pl-10") @(hasError ? "border-danger-500 focus:ring-danger-500/30" : "")" />
        @if (!string.IsNullOrEmpty(Model.Type) && Model.Type == "password")
        {
            <button type="button" data-toggle-password="@inputId" class="absolute inset-y-0 right-0 pr-3 flex items-center text-subtle hover:text-default cursor-pointer" tabindex="-1">
                <i data-lucide="eye" class="w-4 h-4"></i>
            </button>
        }
    </div>
    @if (!string.IsNullOrEmpty(Model.Hint))
    {
        <p class="helper-text">@Model.Hint</p>
    }
    @if (hasError)
    {
        <p class="text-xs font-medium text-danger-700 dark:text-danger-500">@Model.Error</p>
    }
</div>
