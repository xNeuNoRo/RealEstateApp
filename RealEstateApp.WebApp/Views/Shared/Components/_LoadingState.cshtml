@model (int Count, string? Type)
@{
    var type = Model.Type ?? "card";
}
@if (type == "card")
{
    for (int i = 0; i < Model.Count; i++)
    {
        <div class="card-base overflow-hidden animate-pulse">
            <div class="aspect-[16/10] skeleton"></div>
            <div class="p-4 space-y-3">
                <div class="h-5 skeleton w-3/4"></div>
                <div class="h-4 skeleton w-1/2"></div>
                <div class="h-3 skeleton w-full"></div>
                <div class="h-3 skeleton w-2/3"></div>
            </div>
        </div>
    }
}
else if (type == "list")
{
    <div class="space-y-4">
        @for (int i = 0; i < Model.Count; i++)
        {
            <div class="flex items-center gap-4 animate-pulse">
                <div class="w-12 h-12 rounded-xl skeleton shrink-0"></div>
                <div class="flex-1 space-y-2">
                    <div class="h-4 skeleton w-1/3"></div>
                    <div class="h-3 skeleton w-1/2"></div>
                </div>
            </div>
        }
    </div>
}
