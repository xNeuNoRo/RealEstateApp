@model (string Icon, string Value, string Label, string? Href, string ColorClass)
@{
    var icon = Model.Icon ?? "help-circle";
    var value = Model.Value ?? "0";
    var label = Model.Label ?? "";
    var href = Model.Href;
    var colorClass = Model.ColorClass ?? "text-brand-600";
    var bgClass = colorClass switch
    {
        "text-brand-600" => "bg-brand-50 text-brand-600 dark:bg-brand-100/15",
        "text-emerald-500" => "bg-emerald-50 text-emerald-500 dark:bg-emerald-100/15",
        "text-blue-500" => "bg-blue-50 text-blue-500 dark:bg-blue-100/15",
        "text-amber-500" => "bg-amber-50 text-amber-500 dark:bg-amber-100/15",
        "text-red-500" => "bg-red-50 text-red-500 dark:bg-red-100/15",
        _ => "bg-brand-50 text-brand-600 dark:bg-brand-100/15",
    };
    var borderClass = colorClass switch
    {
        "text-emerald-500" => "border-emerald-500/20",
        "text-blue-500" => "border-blue-500/20",
        "text-amber-500" => "border-amber-500/20",
        "text-red-500" => "border-red-500/20",
        _ => "border-brand-500/20",
    };
}

<a href="@(href ?? "#")" class="group relative flex items-center gap-4 rounded-2xl border @borderClass bg-[var(--color-bg-elevated)] p-5 shadow-sm transition-all hover:shadow-md hover:-translate-y-0.5" aria-label="@label: @value">
    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl @bgClass transition-transform group-hover:scale-105">
        <i data-lucide="@icon" class="h-6 w-6"></i>
    </div>
    <div class="min-w-0 flex-1">
        <p class="text-[11px] font-black uppercase tracking-[.12em] text-muted">@label</p>
        <p class="mt-0.5 text-2xl font-black tracking-tight @colorClass">@value</p>
    </div>
    <i data-lucide="arrow-right" class="h-5 w-5 shrink-0 text-muted opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true"></i>
</a>
