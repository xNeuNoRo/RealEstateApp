@model (string Icon, string Title, string? Description, string? Action)
<div class="text-center py-8 sm:py-12 px-4">
    <div class="w-16 h-16 surface-muted rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="@Model.Icon" class="w-8 h-8 text-subtle"></i>
    </div>
    <h3 class="text-lg font-bold text-default mb-1">@Model.Title</h3>
    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <p class="text-muted text-sm max-w-md mx-auto">@Model.Description</p>
    }
    @if (!string.IsNullOrEmpty(Model.Action))
    {
        <div class="mt-4">
            @Html.Raw(Model.Action)
        </div>
    }
</div>
