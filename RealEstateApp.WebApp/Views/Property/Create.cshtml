@model CreatePropertyViewModel
@{
    ViewData["Title"] = "Publicar propiedad";
    var canCreate = Model.PropertyTypes.Count > 0 && Model.SaleTypes.Count > 0 && Model.Improvements.Count > 0;
}

<div class="mx-auto max-w-6xl space-y-7">
    <nav aria-label="Ruta de navegación"><ol class="flex flex-wrap items-center gap-2 text-sm text-muted"><li><a asp-action="MyProperties" class="font-semibold hover:text-brand-600">Mis propiedades</a></li><li aria-hidden="true"><i data-lucide="chevron-right" class="h-4 w-4"></i></li><li class="font-bold text-default" aria-current="page">Publicar propiedad</li></ol></nav>

    <header class="overflow-hidden rounded-3xl border border-brand-100 bg-gradient-to-br from-brand-700 via-brand-600 to-blue-500 p-6 text-white shadow-xl shadow-brand-600/15 sm:p-8">
        <div class="max-w-2xl"><span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs font-black uppercase tracking-[.12em]"><i data-lucide="badge-plus" class="h-4 w-4"></i>Nueva publicación</span><h1 class="mt-4 text-3xl font-black tracking-tight sm:text-4xl">Convierte inmueble en oportunidad.</h1><p class="mt-3 max-w-xl text-sm leading-6 text-blue-100">Presenta información precisa e imágenes de calidad. Código único y estado Disponible se asignan automáticamente.</p></div>
    </header>

    @if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="ModelOnly" class="rounded-2xl border border-danger-500/30 bg-danger-50 p-4 text-sm font-semibold text-danger-700" role="alert"></div> }

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="grid items-start gap-7 lg:grid-cols-[minmax(0,1fr)_19rem]" data-property-form novalidate>
        @Html.AntiForgeryToken()
        <input asp-for="Currency" type="hidden" value="DOP" />
        <div class="space-y-6">
            <partial name="_PropertyFormFields" model="Model" />
            <section class="rounded-3xl border border-default bg-[var(--color-bg-elevated)] p-5 shadow-sm sm:p-7" aria-labelledby="property-images-title">
                <div class="mb-5 flex items-start gap-3"><span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 dark:bg-brand-100/20 dark:text-brand-500"><i data-lucide="images" class="h-5 w-5"></i></span><div><h2 id="property-images-title" class="text-lg font-black text-default">Galería de propiedad</h2><p class="mt-1 text-sm text-muted">Carga entre 1 y 4 imágenes JPG, PNG o WebP, máximo 15 MB cada una.</p></div></div>
                <div data-image-uploader data-existing-count="0" data-input-name="imageFiles">
                    <label class="flex min-h-44 cursor-pointer flex-col items-center justify-center rounded-3xl border-2 border-dashed border-default bg-[var(--color-bg-muted)] px-5 text-center transition hover:border-brand-500 hover:bg-brand-50/60 dark:hover:bg-brand-100/10" data-drop-zone tabindex="0">
                        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-brand-600 shadow-sm dark:bg-gray-800"><i data-lucide="image-up" class="h-6 w-6"></i></span><span class="mt-4 text-sm font-black text-default">Arrastra imágenes o selecciónalas</span><span class="mt-1 text-xs text-muted">Primera imagen será portada de publicación</span>
                        <input type="file" name="imageFiles" accept="image/jpeg,image/png,image/webp" multiple required class="sr-only" data-image-input />
                    </label>
                    <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4" data-image-previews aria-live="polite"></div>
                    <div class="mt-3 flex items-center justify-between gap-3"><span class="text-xs font-semibold text-muted" data-image-status>0 de 4 imágenes</span><span class="text-xs font-semibold text-danger-700" data-image-error role="alert"></span></div>
                    @Html.ValidationMessage("imageFiles", null, new { @class = "mt-1 block text-xs font-semibold text-danger-700" })
                </div>
            </section>
        </div>
        <aside class="rounded-3xl border border-brand-100 bg-gradient-to-br from-brand-50 to-blue-50 p-5 shadow-sm dark:border-brand-100/20 dark:from-brand-100/15 dark:to-blue-100/10 lg:sticky lg:top-24">
            <p class="text-xs font-black uppercase tracking-[.14em] text-brand-700 dark:text-brand-500">Resumen publicación</p><p class="mt-4 text-2xl font-black text-default" data-price-preview>RD$ 0.00</p><div class="mt-4 flex items-center gap-2 rounded-2xl border border-success-500/20 bg-success-50 p-3 text-sm font-bold text-success-700"><i data-lucide="circle-check" class="h-4 w-4"></i>Estado Disponible</div><div class="mt-3 flex items-start gap-2 rounded-2xl border border-default bg-white/70 p-3 text-xs leading-5 text-muted dark:bg-gray-800/50"><i data-lucide="scan-line" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600"></i>Código inmobiliario de 6 dígitos se genera al publicar.</div>
            <button type="submit" class="btn-primary mt-6 w-full" disabled="@(!canCreate)"><i data-lucide="send" class="h-4 w-4"></i>Crear propiedad</button><a asp-action="MyProperties" class="btn-secondary mt-3 w-full"><i data-lucide="arrow-left" class="h-4 w-4"></i>Volver atrás</a>
        </aside>
    </form>
</div>

@section Scripts { <script src="~/js/property-form.js" asp-append-version="true"></script> }
