@model AgentsIndexViewModel
@{
    ViewData["Title"] = "Agentes";
    var paginationValues = new Dictionary<string, object?> { ["searchTerm"] = Model.SearchTerm };
}

<div class="space-y-8">
    <section
        class="overflow-hidden rounded-3xl border border-brand-100 bg-linear-to-br from-brand-50 via-(--color-bg-elevated) to-blue-50 px-5 py-10 dark:from-brand-100/20 dark:to-blue-100/10 sm:px-10">
        <div class="max-w-2xl">
            <span
                class="inline-flex items-center gap-2 rounded-full bg-brand-100 px-3 py-1.5 text-xs font-bold text-brand-700 dark:bg-brand-100/20 dark:text-brand-500"><i
                data-lucide="users-round" class="h-4 w-4"></i>Red de profesionales</span>
                <h1 class="mt-5 text-3xl font-black tracking-tight text-default sm:text-4xl">Encuentra un agente que te
                    acompañe.</h1>
                    <p class="mt-3 text-sm leading-6 text-muted sm:text-base">Conoce a los agentes activos de RealEstateApp y
                        explora sus propiedades disponibles.</p>
                        <form asp-action="Agents" method="get" class="mt-6 flex max-w-xl gap-2">
                            <label for="agent-search" class="sr-only">Buscar agentes</label>
                            <div class="relative min-w-0 flex-1"><i data-lucide="search"
                                                                        class="pointer-events-none absolute left-3.5 top-1/2 h-4 w-4 -translate-y-1/2 text-subtle"></i><input
                                id="agent-search" name="searchTerm" value="@Model.SearchTerm" class="input-base py-3 pl-10"
                                placeholder="Nombre o apellido" autocomplete="off" /></div>
                                <button type="submit" class="btn-primary px-4" aria-label="Buscar agentes"><i data-lucide="arrow-right"
                                                                                                                  class="h-4 w-4"></i><span class="hidden sm:inline">Buscar</span></button>
                                </form>
                            </div>
                        </section>

                        <section aria-labelledby="agents-title">
                            <div class="mb-6 flex items-end justify-between gap-4">
                                <div>
                                    <p class="text-xs font-black uppercase tracking-[0.16em] text-brand-600 dark:text-brand-500">
                                        Profesionales activos</p>
                                        <h2 id="agents-title" class="mt-1 text-2xl font-black tracking-tight text-default">Agentes inmobiliarios
                                        </h2>
                                    </div>
                                    <p class="text-sm text-muted">@Model.Agents.TotalCount @(Model.Agents.TotalCount == 1 ? "agente" :
                                                                                                                                                                        "agentes")</p>
                                    </div>
                                    @if (Model.Agents.Items.Count == 0)
                                    {
                                        var title = string.IsNullOrWhiteSpace(Model.SearchTerm) ? "No hay agentes activos" : "No encontramos agentes con ese nombre";
                                        var text = string.IsNullOrWhiteSpace(Model.SearchTerm) ? "Pronto habrá profesionales disponibles para ayudarte." : "Intenta buscar por otro nombre o apellido.";
                                        var action = string.IsNullOrWhiteSpace(Model.SearchTerm) ? null : "<a href='/Home/Agents' class='btn-primary'>Ver todos los agentes</a>";
                                        var emptyState = ("users-round", title, text, action);
                                        <partial name="~/Views/Shared/Components/_EmptyState.cshtml" model="emptyState" />
                                    }
                                    else
                                    {
                                        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" role="list">
                                            @foreach (var agent in Model.Agents.Items)
                                            {
                                                <article
                                                    class="card-fade-in rounded-2xl border border-default bg-(--color-bg-elevated) p-6 text-center shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-brand-600/10"
                                                    role="listitem">
                                                    <a asp-action="AgentProperties" asp-route-id="@agent.Id" class="block focus:outline-none"
                                                       aria-label="Ver propiedades de @agent.FullName">
                                                        @await Html.PartialAsync("~/Views/Shared/Components/_Avatar.cshtml", (agent.ProfileImage,
                                                agent.FullName, "xl", "mx-auto ring-4 ring-brand-50 dark:ring-brand-100/20 transition-transform duration-300 group-hover:scale-105"))
                                                        <h3 class="mt-4 text-lg font-black text-default">@agent.FullName</h3>
                                                        <p class="mt-1 text-xs font-bold uppercase tracking-[0.12em] text-brand-600 dark:text-brand-500">
                                                            Agente inmobiliario</p>
                                                            <span
                                                                class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-muted transition-colors hover:text-brand-600">Ver
                                                                propiedades<i data-lucide="arrow-up-right" class="h-4 w-4"></i></span>
                                                            </a>
                                                        </article>
                                                    }
                                                </div>
                                                <partial name="_Pagination"
                                                         model="new PaginationViewModel { Action = nameof(HomeController.Agents), CurrentPage = Model.Agents.Page, TotalPages = Model.Agents.TotalPages, RouteValues = paginationValues }" />
                                            }
                                        </section>
                                    </div>
