@using System
@model RealEstateApp.Application.Models.Emails.AccountActivationModel
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <style>
        body { font-family: 'Plus Jakarta Sans', -apple-system, sans-serif; background-color: #F1F5F9; padding: 20px; color: #334155; margin: 0; }
        .inner { background: #fff; max-width: 500px; margin: 0 auto; border-radius: 24px; overflow: hidden; box-shadow: 0 30px 60px -12px rgba(0,0,100,0.1); border: 1px solid rgba(0,0,0,0.05); }
        .branding { padding: 30px 40px 10px; font-weight: 800; font-size: 20px; color: #0F766E; letter-spacing: -0.5px; }
        .branding span { color: #D4A017; }
        .header { padding: 45px 40px; background: linear-gradient(135deg, #0F766E 0%, #115E59 100%); color: #fff; position: relative; }
        .h-title { font-size: 26px; font-weight: 800; margin: 0; line-height: 1.2; }
        .h-subtitle { font-size: 13px; font-weight: 600; opacity: 0.9; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 1.5px; display: block; }
        .content { padding: 45px 40px; }
        .greeting { font-size: 18px; font-weight: 700; color: #0F766E; margin-bottom: 18px; }
        .action-button { display: inline-block; padding: 18px 36px; border-radius: 14px; font-weight: 700; text-decoration: none; font-size: 15px; background-color: #0F766E; color: #fff !important; box-shadow: 0 10px 15px -3px rgba(15,118,110,0.3); }
        .security-banner { background: #FEF2F2; border-radius: 12px; padding: 16px; margin-top: 30px; border: 1px solid #FEE2E2; text-align: center; font-size: 13px; color: #DC2626; font-weight: 600; }
        .footer { padding: 35px 40px; background: #F8FAFC; text-align: center; border-top: 1px solid #F1F5F9; font-size: 12px; color: #94A3B8; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="inner">
        <div class="branding">RealEstate<span>.</span>App</div>
        <div class="header">
            <span class="h-subtitle">Gestion Inmobiliaria</span>
            <div class="h-title">Activa tu Cuenta</div>
        </div>
        <div class="content">
            <div class="greeting">Hola, @Model.UserName</div>
            <p style="font-size: 15px; line-height: 1.8; color: #475569; margin-bottom: 25px;">Su cuenta ha sido registrada correctamente en RealEstateApp. Para activar su usuario y poder iniciar sesion, utilice el siguiente enlace:</p>
            <div style="text-align: center;">
                <a href="@Model.ActivationUrl" class="action-button">Activar mi Cuenta</a>
            </div>
            <p style="font-size: 13px; color: #64748b; text-align: center; margin-top: 25px;">O copia este enlace en tu navegador:<br><span style="word-break: break-all; color: #0F766E; font-weight: 600;">@Model.ActivationUrl</span></p>
            <div class="security-banner">Si usted no realizo este registro, puede ignorar este mensaje.</div>
        </div>
        <div class="footer">Para soporte: @Model.SupportEmail<br>&copy; @DateTime.UtcNow.Year RealEstateApp</div>
    </div>
</body>
</html>
